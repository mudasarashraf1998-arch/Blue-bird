{
  "name": "mads-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original offline-first 3D bus driving game for Android and the web.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/three": "0.186.0",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
